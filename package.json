{
  "name": "emend-cli",
  "version": "0.1.1",
  "description": "Verified AI dependency migrations. Finds which of your lines a version bump actually breaks, fixes them, and proves the result still compiles and passes your tests.",
  "author": "Diyan Bogdanov",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diyanbogdanov/emend.git"
  },
  "homepage": "https://github.com/diyanbogdanov/emend#readme",
  "bugs": {
    "url": "https://github.com/diyanbogdanov/emend/issues"
  },
  "keywords": [
    "dependencies",
    "migration",
    "breaking-changes",
    "api-drift",
    "dependabot",
    "typescript",
    "openapi",
    "security"
  ],
  "type": "module",
  "bin": {
    "emend": "./bin/emend.mjs"
  },
  "files": [
    "bin",
    "dist",
    "src",
    "skills",
    "fixtures",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build.ts",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning test/*.test.ts",
    "emend": "node bin/emend.mjs",
    "demo": "node bin/emend.mjs demo ./emend-demo",
    "audit:removals": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/audit-removals.ts"
  },
  "dependencies": {
    "typescript": "^5.6.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0"
  },
  "private": false
}
