# Emend configuration, by example. Copy to `.env` and uncomment what you need.
#
# Emend loads `.env` from the directory it is *run in*, and real environment
# variables always win over it. Scanning needs none of this — `emend scan` is
# deterministic. A model enters only for repairs, reviews and PR summaries.

# --- Model access (any OpenAI-compatible endpoint) -------------------------
# Pick a provider preset...
#EMEND_LLM_PROVIDER=openrouter   # nebius | fireworks | together | groq |
                                 # deepinfra | openrouter | ollama | vllm
# ...with its key. Each preset reads its own variable; EMEND_LLM_API_KEY is
# the fallback any of them accepts.
#OPENROUTER_API_KEY=             # OPEN_ROUTER_API_KEY works too
#NEBIUS_API_KEY=
#FIREWORKS_API_KEY=
#TOGETHER_API_KEY=
#GROQ_API_KEY=
#DEEPINFRA_API_KEY=
#EMEND_LLM_API_KEY=

# Or skip the presets and point at an endpoint directly.
#EMEND_LLM_BASE_URL=http://localhost:11434/v1
#EMEND_LLM_MODEL=                # `emend models` lists what your provider serves

# Knobs, with their defaults.
#EMEND_LLM_TEMPERATURE=0
#EMEND_LLM_MAX_ATTEMPTS=3
#EMEND_LLM_MAX_TOKENS=32000
#EMEND_EVAL_MODEL=               # scripts/capture-case.ts only

# --- GitHub ----------------------------------------------------------------
# A token raises the rate limit for `--contracts` spec discovery and is
# required for `emend pr --create`. Either name works.
#GITHUB_TOKEN=
#GH_TOKEN=

# --- Hosted service (`emend serve` as a GitHub App) ------------------------
# Without these, `emend serve` is a local dashboard and nothing more.
# Registration walkthrough: docs/github-app-setup.md
#EMEND_GITHUB_APP_ID=
#EMEND_GITHUB_WEBHOOK_SECRET=
# The .pem GitHub hands you, base64-encoded so it survives .env parsing:
#   echo "EMEND_GITHUB_PRIVATE_KEY=$(base64 -i emend.private-key.pem | tr -d '\n')" >> .env
#EMEND_GITHUB_PRIVATE_KEY=
#EMEND_GITHUB_API=https://api.github.com   # override for GHES

# --- Paths and overrides ---------------------------------------------------
#EMEND_DB=~/.emend/emend.db      # SQLite scan history
#EMEND_CACHE=~/.emend/cache      # package tarball cache
#EMEND_REGISTRY=https://registry.npmjs.org

# --- Output ----------------------------------------------------------------
#NO_COLOR=1                      # plain output
#EMEND_DEBUG=1                   # stack traces on fatal errors
